---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { siteName, categorySlug } from '../../data/site';
import { providers } from '../../data/providers';
import ProviderOffer from '../../components/ProviderOffer.astro';
export async function getStaticPaths() { return (await getCollection('articles')).map(article => ({ params: { id: article.id }, props: { article } })); }
const { article } = Astro.props;
const provider = providers.find(p=>p.article===article.id);
const { Content, headings } = await render(article);
const date = article.data.updated || article.data.published;
const related = (await getCollection('articles')).filter(a => a.id !== article.id).sort((a,b) => Number(b.data.category === article.data.category) - Number(a.data.category === article.data.category)).slice(0,3);
const url = new URL(`/articles/${article.id}/`, Astro.site).href;
const schema = [
  { '@context': 'https://schema.org', '@type': 'BlogPosting', headline: article.data.title, description: article.data.description, datePublished: article.data.published.toISOString(), dateModified: date.toISOString(), inLanguage: 'zh-CN', author: { '@type': 'Organization', name: `${siteName}编辑组`, url: new URL('/about/', Astro.site).href }, publisher: { '@type': 'Organization', name: siteName, url: Astro.site?.href, logo: { '@type': 'ImageObject', url: new URL('/favicon.svg', Astro.site).href } }, mainEntityOfPage: url, url, articleSection: article.data.category, keywords: article.data.keywords.join(', ') },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [ { '@type': 'ListItem', position: 1, name: '首页', item: Astro.site?.href }, { '@type': 'ListItem', position: 2, name: article.data.category, item: new URL(`/categories/${categorySlug(article.data.category)}/`, Astro.site).href }, { '@type': 'ListItem', position: 3, name: article.data.title, item: url } ] }
];
const formatDate = (value: Date) => value.toLocaleDateString('zh-CN', { timeZone:'Asia/Shanghai', year:'numeric', month:'long', day:'numeric' });
---
<Base title={article.data.title} description={article.data.description} type="article" schema={schema}>
  <Fragment slot="head"><meta property="article:published_time" content={article.data.published.toISOString()} /><meta property="article:modified_time" content={date.toISOString()} /><meta property="article:section" content={article.data.category} /></Fragment>
  <div class="container article-layout"><article><header class="article-header"><nav class="breadcrumbs" aria-label="面包屑"><a href="/">首页</a><span>/</span><a href={`/categories/${categorySlug(article.data.category)}/`}>{article.data.category}</a><span>/</span><span>文章正文</span></nav><h1>{article.data.title}</h1><p class="article-deck">{article.data.description}</p><div class="article-byline"><a href="/about/">{siteName}编辑组</a><span>发布于 <time datetime={article.data.published.toISOString()}>{formatDate(article.data.published)}</time></span>{article.data.updated && <span>修订于 <time datetime={date.toISOString()}>{formatDate(date)}</time></span>}<span>约 {article.data.readingMinutes} 分钟</span></div></header>{provider && <ProviderOffer provider={provider} />}<div class="article-prose"><Content /></div><div class="article-endnote"><p><strong>这篇文章如何使用：</strong>{provider ? '本文依据运营者提供的套餐资料进行选购分析，注册链接含推广参数；实际价格、额度与优惠条件以服务页面为准。' : '本文为技术概念与选择方法整理；服务条款、客户端版本和平台支持地区可能变化，请优先核对文内官方来源。'}</p><a href="/methodology/">查看内容核验与修订方法 ↗</a></div></article><aside class="article-sidebar" aria-label="文章目录"><div class="toc"><h2>本文导航</h2><ol>{headings.filter(h => h.depth === 2).map(h => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol><p class="toc-note">操作前请核对客户端版本与文内资料。</p></div></aside></div>
  <section class="related-section"><div class="container"><h2>相关文章</h2><div class="article-grid">{related.map(article => <ArticleCard article={article} />)}</div></div></section>
</Base>
