---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ArticleCard from '../components/ArticleCard.astro';
import ProviderCard from '../components/ProviderCard.astro';
import { aiTools, clients, scenarios, questions, guideIds } from '../data/hubs';
import { providers, providerDisclosure, providerPrice, providerCoupon } from '../data/providers';
const hubs = [
  {id:'brands', title:'梯子测评与套餐对比', description:'主推光年梯机场18元120G IEPL专线，收录瞬云、极连云、云图、边缘节点、边界云与鲲鹏加速，附七家测评及注册入口；新增三家套餐资料待核实。'},
  {id:'ai', title:'AI 使用环境', description:'ChatGPT、Claude 与 Gemini 的支持范围、账号条件、客户端分流和连接故障，按平台分别查找。'},
  {id:'clients', title:'客户端教程', description:'Clash Verge Rev、Shadowrocket、v2rayN、v2rayNG、sing-box 和 Stash 的安装来源、订阅配置与排错步骤。'},
  {id:'guides', title:'梯子新手指南', description:'从梯子、VPN 与 VPS 的区别开始，了解套餐、订阅、线路、倍率、隐私与服务风险。'},
  {id:'scenarios', title:'按使用场景选择梯子', description:'日常浏览、AI、预算、流媒体、游戏和办公的选择标准与核验方法。'},
  {id:'questions', title:'常见问题中心', description:'先读直接答案，再进入对应指南：选择、客户端、AI、节点、订阅、设备限制和速度问题。'}
];
export function getStaticPaths() { return ['brands','ai','clients','guides','scenarios','questions'].map(hub=>({params:{hub}})); }
const hub = hubs.find(h=>h.id===Astro.params.hub)!;
const articles = await getCollection('articles');
const guides = guideIds.map(id=>articles.find(a=>a.id===id)!);
---
<Base title={hub.title} description={hub.description} schema={{'@context':'https://schema.org','@type':'CollectionPage',name:hub.title,url:Astro.url.href}}>
<div class="container"><header class="page-intro"><nav class="breadcrumbs" aria-label="面包屑"><a href="/">首页</a><span>/</span><span>{hub.title}</span></nav><h1>{hub.title}</h1><p>{hub.description}</p></header><div class="page-body hub-body">
{hub.id==='brands' && <><div class="provider-grid">{providers.map(provider=><ProviderCard provider={provider} />)}</div><p class="source-note">{providerDisclosure}</p><section class="hub-section"><h2>套餐如何横向比较</h2><div class="comparison-wrap"><table class="comparison-table"><thead><tr><th>品牌</th><th>月付</th><th>月流量</th><th>线路</th><th>优惠码</th><th>适合人群</th></tr></thead><tbody>{providers.map(p=><tr><td><a href={`/articles/${p.article}/`}>{p.name}</a></td><td>{providerPrice(p)}</td><td>{p.traffic}</td><td>{p.lines}</td><td>{providerCoupon(p)}</td><td>{p.focus}</td></tr>)}</tbody></table></div><p>先确定常用设备和任务，用相同网络、客户端与时段比较真实表现。年付折算价格不能与月付直接混为一谈。</p><a class="text-link" href="/articles/plans-and-pricing/">阅读完整价格比较方法 →</a></section></>}
{hub.id==='ai' && <><div class="reading-order"><strong>想直接使用工具？</strong><a class="text-link" href="/ai-tools/">打开完整 AI 工具导航 →</a></div><div class="tool-grid">{aiTools.map(tool=><a class="tool-card" href={`/articles/${tool.article}/`}><span class="tool-mark">{tool.mark}</span><h2>{tool.name}</h2><p>{tool.description}</p><span class="read-link">查看平台指南 →</span></a>)}</div><section class="hub-section soft-panel"><h2>建议按这个顺序检查</h2><ol><li>核对目标产品的官方支持范围、账号类型和权限。</li><li>保存原始错误，判断是权限、账单、配额还是连接问题。</li><li>从应用实际运行位置测试，检查请求有没有走预期路径。</li><li>每次只改变一个变量，并对照平台状态页。</li></ol><a class="text-link" href="/articles/ai-connection-errors/">打开 AI 访问故障排查 →</a></section></>}
{hub.id==='clients' && <><div class="client-grid">{clients.map(client=><article class="client-card"><span class="platform-label">{client.platforms}</span><h2><a href={`/articles/${client.article}/`}>{client.name}</a></h2><p>{client.description}</p><p class="client-format">订阅：{client.format}</p><div class="client-actions"><a class="text-link" href={client.source} target="_blank" rel="noopener noreferrer">官方获取 ↗</a><a class="text-link" href={`/articles/${client.article}/`}>完整教程 →</a></div></article>)}</div><section class="hub-section"><h2>从下载安装到第一次连接</h2><ol><li>按系统与 CPU 架构选择安装包；iPhone 和 iPad 先核对 App Store 可用地区与价格。</li><li>从已购买服务的面板复制对应客户端的订阅，勿将账号密码填入订阅地址。</li><li>添加远程配置、更新、激活，再选择节点；有多个配置时确认当前启用项。</li><li>按客户端说明启用系统代理或 VPN 权限，先打开普通页面，再验证目标应用。</li><li>记录连接错误与客户端版本，按订阅、DNS、接管范围分别排查。</li></ol><a class="text-link" href="/articles/subscription-import/">查看完整订阅导入步骤 →</a></section><section class="hub-section soft-panel"><h2>订阅格式先于客户端名称</h2><p>软件维护状态、内核版本、系统权限和服务方提供的格式需要一起核对。客户端与线路订阅分别购买；系统代理、VPN 和 TUN 的接管范围也不同。</p><a class="text-link" href="/articles/device-clients/">查看跨平台客户端选择方法 →</a></section></>}
{hub.id==='guides' && <><div class="reading-order"><strong>推荐顺序</strong><span>理解概念 → 明确预算 → 看懂线路 → 导入订阅 → 验证实际任务</span></div><div class="guide-steps"><section><h2>01 · 先明确用途与预算</h2><p>列出设备、月用量和常用应用。18 元预算可先比较光年梯的 120G IEPL 方案；预算更低则核对鲲鹏加速的 12 元直连套餐。</p><a class="text-link" href="/brands/">查看品牌套餐对比 →</a></section><section><h2>02 · 安装与导入订阅</h2><p>从官方来源获取客户端，选择匹配的订阅格式。更新后先激活配置、选择节点，再确认系统代理或 VPN 权限。</p><a class="text-link" href="/clients/">按设备选择客户端 →</a></section><section><h2>03 · 完成一次真实任务</h2><p>先确认普通网络可用，再用常用网页、会议或视频验证。遇到失败，区分订阅下载、配置解析和实际连接阶段。</p><a class="text-link" href="/categories/troubleshooting/">打开网络问题中心 →</a></section></div><section class="hub-section"><h2>完整入门阅读清单</h2><div class="article-grid">{guides.map(article=><ArticleCard article={article} />)}</div></section><section class="hub-section soft-panel"><h2>开始使用前核对这六项</h2><p>月付价格、月流量、节点倍率、同时在线限制、退款规则和支持渠道。先确认这些条件，再考虑优惠与续费周期。</p><a class="text-link" href="/articles/beginner-checklist/">阅读新手清单 →</a></section></>}
{hub.id==='scenarios' && <><div class="scenario-grid">{scenarios.map(s=><a class="scenario-card" href={`/articles/${s.article}/`}><span class="platform-label">{s.label}</span><h2>{s.name}</h2><p>{s.description}</p><span class="read-link">阅读选择指南 →</span></a>)}</div><section class="hub-section soft-panel"><h2>同一线路，为什么体验不同？</h2><p>地区、运营商、终端、时段和目标服务都会影响结果。下载吞吐量、游戏延迟和会议连续性是不同指标，应当用自己的真实任务核验。</p><a class="text-link" href="/articles/scenario-checklist/">查看分场景测试清单 →</a></section></>}
{hub.id==='questions' && <><div class="question-list">{questions.map((q,i)=><section class="question-answer" id={`question-${i+1}`}><h2>{q.q}</h2><p>{q.a}</p><a class="text-link" href={`/articles/${q.article}/`}>查看详细步骤 →</a></section>)}</div><section class="hub-section soft-panel"><h2>没有找到相同症状？</h2><p>用客户端名或错误文字搜索；求助时记录系统、版本、时间、网络与已做对照，并隐藏订阅、账号与密钥。</p><a class="text-link" href="/search/">搜索全部文章 →</a></section></>}
</div></div>
</Base>
