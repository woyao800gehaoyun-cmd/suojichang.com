---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ArticleCard from '../components/ArticleCard.astro';
import ProviderCard from '../components/ProviderCard.astro';
import { aiTools, clients, scenarios, questions, guideIds } from '../data/hubs';
import { providers, providerDisclosure } from '../data/providers';
const hubs = [
  {id:'brands', title:'梯子测评与套餐对比', description:'主推光年梯机场18元120G IEPL专线，对比瞬云、云图与鲲鹏加速的价格、流量、线路和优惠码，附四家测评与注册入口。'},
  {id:'ai', title:'AI 使用环境', description:'ChatGPT、Claude 与 Gemini 的支持范围、账号条件、客户端分流和连接故障，按平台分别查找。'},
  {id:'clients', title:'客户端教程', description:'Clash Verge Rev、Shadowrocket、v2rayN、v2rayNG、sing-box 和 Stash 的安装来源、订阅配置与排错步骤。'},
  {id:'guides', title:'梯子新手指南', description:'从梯子、VPN 与 VPS 的区别开始，了解套餐、订阅、线路、倍率、隐私与服务风险。'},
  {id:'scenarios', title:'按使用场景选择梯子', description:'日常浏览、AI、预算、流媒体、游戏和办公的选择标准与核验方法。'},
  {id:'questions', title:'常见问题中心', description:'先读直接答案，再进入对应指南：选择、客户端、AI、节点、订阅、设备限制和速度问题。'}
];
export function getStaticPaths() { return ['brands','ai','clients','guides','scenarios','questions'].map(hub=>({params:{hub}})); }
const hub = hubs.find(h=>h.id===Astro.params.hub)!;
const articles = await getCollection('articles');
const guides = guideIds.map(id=>articles.find(a=>a.id===id)!);
---
<Base title={hub.title} description={hub.description} schema={{'@context':'https://schema.org','@type':'CollectionPage',name:hub.title,url:Astro.url.href}}>
<div class="container"><header class="page-intro"><nav class="breadcrumbs" aria-label="面包屑"><a href="/">首页</a><span>/</span><span>{hub.title}</span></nav><h1>{hub.title}</h1><p>{hub.description}</p></header><div class="page-body hub-body">
{hub.id==='brands' && <><div class="provider-grid">{providers.map(provider=><ProviderCard provider={provider} />)}</div><p class="source-note">{providerDisclosure}</p><section class="hub-section"><h2>套餐如何横向比较</h2><div class="comparison-wrap"><table class="comparison-table"><thead><tr><th>品牌</th><th>月付</th><th>月流量</th><th>线路</th><th>优惠码</th><th>适合人群</th></tr></thead><tbody>{providers.map(p=><tr><td><a href={`/articles/${p.article}/`}>{p.name}</a></td><td>¥{p.price}/月</td><td>{p.traffic}</td><td>{p.lines}</td><td>{p.coupon || '暂无'}</td><td>{p.focus}</td></tr>)}</tbody></table></div><p>先确定常用设备和任务，用相同网络、客户端与时段比较真实表现。年付折算价格不能与月付直接混为一谈。</p><a class="text-link" href="/articles/plans-and-pricing/">阅读完整价格比较方法 →</a></section></>}
{hub.id==='ai' && <><div class="tool-grid">{aiTools.map(tool=><a class="tool-card" href={`/articles/${tool.article}/`}><span class="tool-mark">{tool.mark}</span><h2>{tool.name}</h2><p>{tool.description}</p><span class="read-link">查看平台指南 →</span></a>)}</div><section class="hub-section soft-panel"><h2>建议按这个顺序检查</h2><ol><li>核对目标产品的官方支持范围、账号类型和权限。</li><li>保存原始错误，判断是权限、账单、配额还是连接问题。</li><li>从应用实际运行位置测试，检查请求有没有走预期路径。</li><li>每次只改变一个变量，并对照平台状态页。</li></ol><a class="text-link" href="/articles/ai-connection-errors/">打开 AI 访问故障排查 →</a></section></>}
{hub.id==='clients' && <><div class="client-grid">{clients.map(client=><a class="client-card" href={`/articles/${client.article}/`}><span class="platform-label">{client.platforms}</span><h2>{client.name}</h2><p>{client.description}</p><span class="read-link">安装与使用教程 →</span></a>)}</div><section class="hub-section soft-panel"><h2>订阅格式先于客户端名称</h2><p>软件维护状态、内核版本、系统权限和服务方提供的格式需要一起核对。购买客户端不等于购买线路，网络服务也不应要求你交出平台密码。</p><a class="text-link" href="/articles/device-clients/">查看跨平台客户端选择方法 →</a></section></>}
{hub.id==='guides' && <><div class="reading-order"><strong>推荐顺序</strong><span>理解概念 → 明确预算 → 看懂线路 → 导入订阅 → 验证实际任务</span></div><div class="article-grid">{guides.map(article=><ArticleCard article={article} />)}</div></>}
{hub.id==='scenarios' && <><div class="scenario-grid">{scenarios.map(s=><a class="scenario-card" href={`/articles/${s.article}/`}><span class="platform-label">{s.label}</span><h2>{s.name}</h2><p>{s.description}</p><span class="read-link">阅读选择指南 →</span></a>)}</div><section class="hub-section soft-panel"><h2>同一线路，为什么体验不同？</h2><p>地区、运营商、终端、时段和目标服务都会影响结果。下载吞吐量、游戏延迟和会议连续性是不同指标，应当用自己的真实任务核验。</p><a class="text-link" href="/articles/scenario-checklist/">查看分场景测试清单 →</a></section></>}
{hub.id==='questions' && <><div class="question-list">{questions.map((q,i)=><section class="question-answer" id={`question-${i+1}`}><h2>{q.q}</h2><p>{q.a}</p><a class="text-link" href={`/articles/${q.article}/`}>查看详细步骤 →</a></section>)}</div><section class="hub-section soft-panel"><h2>没有找到相同症状？</h2><p>用客户端名或错误文字搜索；求助时记录系统、版本、时间、网络与已做对照，并隐藏订阅、账号与密钥。</p><a class="text-link" href="/search/">搜索全部文章 →</a></section></>}
</div></div>
</Base>
