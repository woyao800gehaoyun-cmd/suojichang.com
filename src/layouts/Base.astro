---
import globalStyles from '../styles/simple.css?raw';
import { siteName } from '../data/site';
import Icon from '../components/Icon.astro';
import BrandMark from '../components/BrandMark.astro';
interface Props { title: string; description: string; schema?: Record<string, unknown> | Record<string, unknown>[]; noindex?: boolean; type?: string }
const { title, description, schema, noindex = false, type = 'website' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const schemas = Array.isArray(schema) ? schema : schema ? [schema] : [];
const baseSchema = {
  '@context': 'https://schema.org', '@type': 'WebSite', name: siteName,
  url: Astro.site?.href, inLanguage: 'zh-CN', description: '面向长期使用的梯子选择指南、客户端教程与网络排障知识库。'
};
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <style is:inline set:html={globalStyles} />
    <title>{title.includes(siteName) ? title : `${title} · ${siteName}`}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={`${siteName} RSS`} href="/rss.xml" />
    <meta name="theme-color" content="#176da1" />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/images/social-card.png', Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="2026梯子推荐：梯子选择、客户端教程与网络排障" />
    <meta name="twitter:card" content="summary_large_image" />
    {[baseSchema, ...schemas].map(item => <script type="application/ld+json" set:html={JSON.stringify(item).replace(/</g, '\u003c')} />)}
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">跳到正文</a>
    <header class="site-header">
      <div class="container header-inner">
        <a href="/" class="brand" aria-label={`${siteName}首页`}><BrandMark /><span>{siteName}</span></a>
        <nav class="desktop-nav" aria-label="主导航">
          <a href="/#recommendations">梯子推荐</a><a href="/guides/" aria-current={Astro.url.pathname==='/guides/'?'page':undefined}>新手指南</a><a href="/ai/" aria-current={Astro.url.pathname==='/ai/'?'page':undefined}>AI 使用</a><a href="/clients/" aria-current={Astro.url.pathname==='/clients/'?'page':undefined}>客户端</a><a href="/categories/troubleshooting/">网络问题</a><a href="/brands/" aria-current={Astro.url.pathname==='/brands/'?'page':undefined}>品牌资料</a>
        </nav>
        <a class="header-search" href="/search/" aria-label="搜索文章"><Icon name="search" size={19} /><span>搜索</span></a>
        <details class="mobile-menu"><summary aria-label="展开导航"><span></span><span></span><span></span></summary><nav aria-label="移动端导航"><a href="/#recommendations">梯子推荐</a><a href="/guides/">新手指南</a><a href="/ai/">AI 使用环境</a><a href="/clients/">客户端教程</a><a href="/brands/">品牌资料</a><a href="/categories/troubleshooting/">故障排查</a><a href="/questions/">常见问题</a><a href="/articles/">全部文章</a><a href="/topics/">主题索引</a></nav></details>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <div class="container footer-main"><div><a href="/" class="footer-title">{siteName}</a><p>梯子选择、线路知识、客户端教程与网络排障。</p></div><nav aria-label="页脚导航"><a href="/articles/">全部文章</a><a href="/topics/">主题索引</a><a href="/questions/">常见问题</a><a href="/about/">关于本站</a><a href="/methodology/">内容说明</a><a href="/privacy/">隐私说明</a><a href="/rss.xml">RSS</a></nav></div>
      <div class="container footer-bottom"><span>© {new Date().getFullYear()} {siteName} · soujichang.com</span><a href="#main">回到顶部 ↑</a></div>
    </footer>
  </body>
</html>
